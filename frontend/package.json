		"svelte": "^5.55.5",
		"svelte-adapter-bun": "^0.5.2",
		"svelte-check": "^4.4.7",
		"tailwindcss": "^4.2.4",
		"typescript": "^5.9.3",
		"vite": "^6.4.2"
	},
	"dependencies": {
		"@lucide/svelte": "^0.511.0"
